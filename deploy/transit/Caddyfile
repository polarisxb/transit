{
	email {$ACME_EMAIL}
}

(newapi_proxy) {
	# 不开 encode：API 是 JSON / SSE，压缩收益小，还可能缓冲流式响应
	reverse_proxy new-api:3000 {
		flush_interval -1
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 10s
			read_timeout 30m
			write_timeout 30m
			response_header_timeout 30m
		}
	}
}

(portal_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}

(portal_files) {
	import portal_headers
	@hashed path /portal-assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	root * /srv/portal
	encode gzip
	try_files {path} /index.html
	file_server
}

# 用户门户 + 对外 API（和 refresh cookie 同 origin）。
# 只把 router/*.go 里的 API 前缀交给 new-api，其余一律门户，避免 /login /console /about 露出后台 SPA。
# 前缀来源：router/{api-router,relay-router,dashboard,video-router,task-router,task-plugin-protocol-router}.go
# 没有 /v2、没有独立的图片/文件站点。HostProtocols 默认都在 /v1。
# 自定义 JS 插件若挂了非 /v1 的公开路径，要把前缀加进 @upstream_prefix，否则客户端拿到门户 HTML。
# path 与 path_regexp 不能写进同一个 matcher（同组是 AND），所以拆成两个 handle。
{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"

	handle /robots.txt {
		header Content-Type text/plain
		respond "User-agent: *\nDisallow: /\n" 200
	}

	handle /portal-config.json {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"consoleOrigin":"https://{$CONSOLE_DOMAIN}"}` 200
	}

	@upstream_prefix {
		path /api /api/* /v1 /v1/* /v1beta /v1beta/* /mj /mj/* /pg /pg/* /dashboard /dashboard/*
	}
	# Midjourney 还挂了 /:mode/mj（例如 /imagine/mj/...），只匹配「恰好一段 + /mj」
	@upstream_mj_mode {
		path_regexp ^/[^/]+/mj(/.*)?$
	}

	handle @upstream_prefix {
		import newapi_proxy
	}
	handle @upstream_mj_mode {
		import newapi_proxy
	}

	handle {
		import portal_files
	}
}

# new-api 原生后台：初始化向导、渠道、兑换码。不要和门户共用主机名。
{$CONSOLE_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	import newapi_proxy
}

