# 复制为 .env 后填写。.env 已在 .gitignore 中，不要提交。

# 镜像：GitHub Actions 从本 fork 的 transit 分支构建并推到 GHCR。换成你自己的 GitHub 用户名
TRANSIT_IMAGE=ghcr.io/polarisxb/transit:latest
# 用户门户静态文件。只改门户时只重建这个镜像，不用等 Go 构建
TRANSIT_PORTAL_IMAGE=ghcr.io/polarisxb/transit-portal:latest

# 两个主机名都要 A 记录指向服务器公网 IP。不要开 Cloudflare 橙云代理（有 100 秒响应超时，会掐断 Claude Code 长任务）
# 用户门户 + /v1 API（朋友用这个）
DOMAIN=api.example.com
# new-api 原生后台：初始化、渠道、兑换码。必须和 DOMAIN 不是同一个主机名
CONSOLE_DOMAIN=console.example.com
# Let's Encrypt 证书到期提醒邮箱
ACME_EMAIL=you@example.com

# 以下四个密钥各自用 `openssl rand -hex 32` 生成，互不相同
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
CRYPTO_SECRET=

TZ=Asia/Shanghai
